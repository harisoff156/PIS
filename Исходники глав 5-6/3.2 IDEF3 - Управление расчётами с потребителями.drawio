  <diagram name="IDEF3 - Управление расчётами с потребителями" id="idef3_billing">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Рисунок 3.2. Организационно-логическая схема подсистемы «Управление расчётами с потребителями» (IDEF3)" style="text;html=1;align=center;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="1400" height="20" as="geometry" />
        </mxCell>

        <!-- IDEF3 process boxes - "Поведенческие единицы работы" UOB -->
        <mxCell id="start" value="Начало&#10;ежемесячного&#10;цикла биллинга" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="t31" value="3.1 Сбор показаний&#10;приборов учёта&#10;(операторы, потребители,&#10;АИИС КУЭ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="220" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t31_label" value="UOB 1" style="text;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="225" y="350" width="40" height="20" as="geometry" />
        </mxCell>

        <mxCell id="t32" value="3.2 Расчёт стоимости&#10;по тарифам&#10;(применение справочника&#10;тарифов)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="220" width="180" height="120" as="geometry" />
