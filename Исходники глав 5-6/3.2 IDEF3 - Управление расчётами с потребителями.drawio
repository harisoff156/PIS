        </mxCell>

        <mxCell id="t33" value="3.3 Формирование&#10;счетов-квитанций&#10;и доставка" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
